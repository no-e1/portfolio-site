// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProjectMediaType {
  image
  gif
}

enum ProjectLinkType {
  website
  github
  document
}

enum PrivateDocumentType {
  curriculumVitae
  gibbCertificate
  bwdCertificate
  secondarySchoolCertificate
  uekCompetenceRecord
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @db.VarChar(255)
  isActive     Boolean  @default(true)
  loginCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @db.VarChar(255)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Project {
  id               Int              @id @default(autoincrement())
  slug             String           @unique @db.VarChar(191)
  title            String           @db.VarChar(160)
  shortDescription String           @db.Text
  longDescription  String           @db.LongText
  period           String           @db.VarChar(120)
  coverType        ProjectMediaType
  coverSrc         String           @db.VarChar(2048)
  sortOrder        Int              @default(0)
  isPublished      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tags  ProjectTag[]
  media ProjectMedia[]
  links ProjectLink[]

  @@index([isPublished, sortOrder])
}

model ProjectTag {
  id        Int    @id @default(autoincrement())
  projectId Int
  label     String @db.VarChar(60)
  sortOrder Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, label])
  @@index([projectId, sortOrder])
}

model ProjectMedia {
  id        Int              @id @default(autoincrement())
  projectId Int
  type      ProjectMediaType
  src       String           @db.VarChar(2048)
  alt       String?          @db.VarChar(255)
  sortOrder Int              @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model ProjectLink {
  id        Int             @id @default(autoincrement())
  projectId Int
  type      ProjectLinkType
  label     String          @db.VarChar(80)
  href      String          @db.VarChar(2048)
  sortOrder Int             @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model AboutPage {
  id               Int                    @id @default(autoincrement())
  title            String                 @db.VarChar(160)
  isPublished      Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  sections         AboutSection[]
  competencies     AboutCompetency[]
  technologyGroups AboutTechnologyGroup[]
}

model AboutSection {
  id           Int                @id @default(autoincrement())
  aboutPageId  Int
  heading      String             @db.VarChar(160)
  body         String             @db.LongText
  sortOrder    Int                @default(0)
  bulletPoints AboutBulletPoint[]

  aboutPage AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId, sortOrder])
}

model AboutBulletPoint {
  id             Int    @id @default(autoincrement())
  aboutSectionId Int
  heading        String @db.VarChar(160)
  body           String @db.LongText
  sortOrder      Int    @default(0)

  aboutSection AboutSection @relation(fields: [aboutSectionId], references: [id], onDelete: Cascade)

  @@index([aboutSectionId, sortOrder])
}

model AboutCompetency {
  id          Int    @id @default(autoincrement())
  aboutPageId Int
  title       String @db.VarChar(160)
  description String @db.LongText
  sortOrder   Int    @default(0)

  aboutPage AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId, sortOrder])
}

model AboutTechnologyGroup {
  id           Int               @id @default(autoincrement())
  aboutPageId  Int
  heading      String            @db.VarChar(160)
  sortOrder    Int               @default(0)
  technologies AboutTechnology[]

  aboutPage AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId, sortOrder])
}

model AboutTechnology {
  id                     Int    @id @default(autoincrement())
  aboutTechnologyGroupId Int
  name                   String @db.VarChar(160)
  context                String @db.VarChar(160)
  description            String @db.LongText
  sortOrder              Int    @default(0)

  aboutTechnologyGroup AboutTechnologyGroup @relation(fields: [aboutTechnologyGroupId], references: [id], onDelete: Cascade)

  @@index([aboutTechnologyGroupId, sortOrder])
}

model HobbyPage {
  id           Int            @id @default(1)
  introduction String         @db.Text
  isPublished  Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sections     HobbySection[]
}

model HobbySection {
  id                Int        @id @default(autoincrement())
  hobbyPageId       Int
  title             String     @db.VarChar(160)
  description       String     @db.LongText
  imageStorageName  String     @unique @db.VarChar(255)
  imageOriginalName String     @db.VarChar(255)
  imageMimeType     String     @db.VarChar(100)
  imageSize         Int
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  tags              HobbyTag[]

  hobbyPage HobbyPage @relation(fields: [hobbyPageId], references: [id], onDelete: Cascade)

  @@index([hobbyPageId, sortOrder])
}

model HobbyTag {
  id             Int    @id @default(autoincrement())
  hobbySectionId Int
  label          String @db.VarChar(60)
  sortOrder      Int    @default(0)

  hobbySection HobbySection @relation(fields: [hobbySectionId], references: [id], onDelete: Cascade)

  @@unique([hobbySectionId, label])
  @@index([hobbySectionId, sortOrder])
}

model Document {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(191)
  title       String   @db.VarChar(160)
  description String?  @db.Text
  body        String   @db.LongText
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model PrivateDocument {
  id           Int                 @id @default(autoincrement())
  type         PrivateDocumentType @default(uekCompetenceRecord)
  title        String              @db.VarChar(160)
  storageName  String              @unique @db.VarChar(255)
  originalName String              @db.VarChar(255)
  mimeType     String              @default("application/pdf") @db.VarChar(100)
  size         Int
  createdAt    DateTime            @default(now())

  @@index([createdAt])
}
