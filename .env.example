# GHCR image selection
GHCR_NAMESPACE=no-e1
IMAGE_TAG=0123456789abcdef0123456789abcdef01234567

# Cloudflare tunnel token
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# MariaDB - Generate hexadecimal passwords so the database URL remains valid.
MARIADB_DATABASE=portfolio
MARIADB_USER=portfolio
MARIADB_PASSWORD=replace-with-openssl-rand-hex-32
MARIADB_ROOT_PASSWORD=replace-with-another-openssl-rand-hex-32

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_JWT_SECRET=replace-with-a-different-long-random-secret

TZ=Europe/Zurich
